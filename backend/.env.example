# ---------------------------------------------------------------------------
# Aegis Quant - environment configuration
# Copy this file to .env and fill in values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Binance -------------------------------------------------------------------
# Market data collection (Phase 1) is 100% public REST/WebSocket endpoints and
# needs no key. Keys below are required only from the Execution phase onward,
# and must NEVER have withdrawal permission enabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Trading safety defaults ----------------------------------------------------
LIVE_TRADING=false
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10

# Collector -------------------------------------------------------------------
# Symbols to bootstrap + stream on startup (comma separated, no spaces) -
# should be the UNION of CORE_TRADING_SYMBOLS + SPECULATIVE_SYMBOLS below,
# or those buckets won't have candles to trade on
COLLECTOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,1000PEPEUSDT,NEARUSDT
# Kline intervals to subscribe to per symbol (comma separated)
COLLECTOR_INTERVALS=1m,5m,15m,1h,4h,1d
# How many historical klines to backfill per (symbol, interval) on bootstrap
COLLECTOR_KLINE_BOOTSTRAP_LIMIT=500

# Speculative bucket (Fase 13) --------------------------------------------------
# Core trades on 1h; speculative trades a separate, higher-volatility symbol
# set on a shorter interval ("quick return" opportunities the 1h loop is too
# slow to catch) - both evaluated by the same Paper/Shadow engines
CORE_TRADING_SYMBOLS=BTCUSDT,ETHUSDT
SPECULATIVE_SYMBOLS=SOLUSDT,XRPUSDT,DOGEUSDT,1000PEPEUSDT,NEARUSDT
SPECULATIVE_INTERVAL=15m

# Momentum / "moonshot" scanner (Fase 14) ---------------------------------------
# No fixed symbol list - the Scanner picks liquid, high-momentum candidates
# dynamically each MOMENTUM_SCAN_INTERVAL_SECONDS. MOMENTUM_MIN_QUOTE_VOLUME
# is a real liquidity floor (24h USDT volume) - excludes thin/new listings
# by design, not an afterthought filter
MOMENTUM_MIN_QUOTE_VOLUME=500000000
MOMENTUM_TOP_N=5
MOMENTUM_SCAN_INTERVAL_SECONDS=900
MOMENTUM_TRAILING_CALLBACK_RATE_PCT=2.0
MOMENTUM_TRAILING_ACTIVATION_PCT=1.5

# Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO

# Database (Phase 2) -----------------------------------------------------------
# Matches the defaults in the repo-root docker-compose.yml. Leave empty to
# disable persistence entirely (collector falls back to log-only output).
DATABASE_URL=postgresql://aegis:aegis_dev_password@localhost:5432/aegis
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_WRITER_BATCH_SIZE=200
DB_WRITER_FLUSH_INTERVAL=1.0
DB_WRITER_QUEUE_MAX_SIZE=20000

# Macro Engine (Phase 5 - FRED) -------------------------------------------------
# Free, instant self-service registration: https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, run_macro_engine.py just skips FRED-sourced series (logged),
# BLS-sourced ones still run.
FRED_API_KEY=
MACRO_SERIES_CONFIG_PATH=macro_series.yaml
MACRO_POLL_INTERVAL_SECONDS=21600
MACRO_HISTORY_LIMIT=260

# Macro Engine (Phase 5b - BLS) --------------------------------------------------
# Optional: BLS Public Data API v2 works unregistered at lower limits.
# Free key (raises limits): https://data.bls.gov/registrationEngine/
BLS_API_KEY=
BLS_HISTORY_YEARS=3

# Macro Engine (Phase 5c - BEA) --------------------------------------------------
# Mandatory, like FRED - no anonymous access. Free signup (instant):
# https://apps.bea.gov/API/signup/index.cfm
# Without it, run_macro_engine.py just skips BEA-sourced series (logged).
BEA_API_KEY=
BEA_YEARS_BACK=10

# Event Risk Engine / CoinMarketCal (Fase 15b) -------------------------------
# Crypto-specific events (listings, mainnet launches, forks) - NOT macro
# events (FOMC/CPI/NFP), which have no good free API - see backend/README.md
# "Métricas da Fase 15b" for why. Free signup: https://coinmarketcal.com/developer
# Without it, run_event_risk_engine.py refuses to run (logged), same policy
# as FRED/BEA.
COINMARKETCAL_API_KEY=
EVENT_RISK_POLL_INTERVAL_SECONDS=3600
EVENT_RISK_COIN_SLUGS=bitcoin,ethereum,solana,ripple,dogecoin,pepe,near-protocol

# Notifications / Telegram (Fase 15b) -----------------------------------------
# Optional - engines run identically without it, just silently skip
# sending. Create a bot via @BotFather for the token; the chat id is the
# numeric id of the chat/channel/group to post to (negative for
# channels/groups). Alerts only on Kill Switch triggers and
# MANUAL_INTERVENTION_REQUIRED (a real position left unprotected).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# BingX (Fase 16/17, see backend/README.md) --------------------------------------
# Brazil doesn't offer Binance Futures as a real/live account option, so
# execution migrated to BingX. As of Fase 17, the active key and demo/live mode
# are managed from the dashboard (Configurações > BingX) and stored encrypted in
# the database - BINGX_API_KEY/SECRET/TESTNET below are ONLY used to auto-seed
# that database row the first time the app starts after a fresh install; the
# trading scripts never read them directly afterward. BingX uses the SAME
# key/secret for both its VST (demo) balance and its real balance - there is
# only one credential to manage, the dashboard toggle just picks which balance
# requests go against.
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_TESTNET=true

# Credential encryption (Fase 17 - BingX demo/live account switching) -----------
# Encrypts the BingX API key/secret at rest so the dashboard can switch between
# demo and real trading without touching .env or restarting anything. Generate
# once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Future phases (not required yet) --------------------------------------------
REDIS_URL=
NEWS_ENABLED=true
